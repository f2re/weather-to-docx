# Основной каталог сохраняемых данных
WTD_DATA_DIR=/var/lib/weather-to-docx

# HTTP-интерфейс. Для внешней сети используйте reverse proxy с TLS.
WTD_API_HOST=127.0.0.1
WTD_API_PORT=8080

# Прогноз по умолчанию для интерфейса и Telegram.
# Часовой пояс используется только как явный резерв, если локальный поиск по
# координатам не дал результата.
WTD_DEFAULT_TIMEZONE=Europe/Moscow
WTD_DEFAULT_FORECAST_DAYS=7
WTD_DEFAULT_SOURCE_IDS=open_meteo_gfs,open_meteo_ecmwf_ifs,open_meteo_dwd_icon_global,open_meteo_gefs_0p25

# Устойчивая очередь: lease должен быть больше двойного heartbeat.
WTD_WORKER_HEARTBEAT_SECONDS=5
WTD_WORKER_LEASE_SECONDS=30
WTD_WORKER_ONLINE_MAX_AGE_SECONDS=20
WTD_WORKER_MAX_ATTEMPTS=3

# DaData: token нужен для городов и подсказок; secret — для пакетной очистки адресов
WTD_DADATA_TOKEN=
WTD_DADATA_SECRET=
WTD_DADATA_TIMEOUT_SECONDS=20
WTD_DADATA_SUGGESTION_COUNT=5

# Telegram. Токен выдаёт @BotFather. Список ID ограничивает доступ к боту.
WTD_TELEGRAM_ENABLED=false
WTD_TELEGRAM_BOT_TOKEN=
WTD_TELEGRAM_ALLOWED_USER_IDS=
WTD_TELEGRAM_MAX_LOCATIONS=100
WTD_TELEGRAM_MAX_INPUT_BYTES=20971520
WTD_TELEGRAM_MAX_OUTPUT_BYTES=52428800
WTD_TELEGRAM_CONCURRENCY=2
WTD_TELEGRAM_JOB_POLL_SECONDS=3
WTD_TELEGRAM_JOB_TIMEOUT_SECONDS=1800

# Уровень журналирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
WTD_LOG_LEVEL=INFO

# Сетевые параметры шлюза или подключённой установки
WTD_HTTP_TIMEOUT_SECONDS=60
WTD_HTTP_MAX_RETRIES=3
WTD_HTTP_USER_AGENT=weather-to-docx/0.3.1 (+https://github.com/f2re/weather-to-docx)

# Для полностью изолированного контура рекомендуется включить проверку подписи
WTD_REQUIRE_BUNDLE_SIGNATURE=false
# WTD_BUNDLE_PUBLIC_KEY=/etc/weather-to-docx/keys/forecast-bundle-public.pem
