[Unit]
Description=Weather to DOCX queue worker
Documentation=file:/opt/weather-to-docx/current/share/docs/ARCHITECTURE.md
After=network.target weather-to-docx-api.service

[Service]
Type=simple
User=weatherdoc
Group=weatherdoc
WorkingDirectory=/var/lib/weather-to-docx
EnvironmentFile=-/etc/weather-to-docx/weather-to-docx.env
Environment=MPLBACKEND=Agg
Environment=MPLCONFIGDIR=/var/lib/weather-to-docx/cache/matplotlib
ExecStart=/opt/weather-to-docx/current/venv/bin/weather-to-docx worker --poll-interval 5
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/weather-to-docx
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
