# Корневой каталог рабочих данных
WTD_DATA_DIR=/var/lib/weather-to-docx

# SQLite. Если путь не указан, используется $WTD_DATA_DIR/database/weather-to-docx.sqlite3
# WTD_DATABASE_PATH=/var/lib/weather-to-docx/database/weather-to-docx.sqlite3

# Сетевые параметры загрузчиков
WTD_HTTP_TIMEOUT_SECONDS=60
WTD_HTTP_MAX_RETRIES=3
WTD_HTTP_USER_AGENT=weather-to-docx/0.5.1 (+https://github.com/f2re/weather-to-docx)

# В закрытом контуре подпись входящих пакетов можно сделать обязательной
WTD_REQUIRE_BUNDLE_SIGNATURE=false
# WTD_BUNDLE_PUBLIC_KEY=/etc/weather-to-docx/keys/forecast-bundle-public.pem

# Журналирование
WTD_LOG_LEVEL=INFO
